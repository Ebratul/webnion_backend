NODE_ENV=development
PORT=5000

# Matches docker-compose.yml for local development
DATABASE_URL=postgresql://webnion:webnion_local@localhost:5440/webnion
TEST_DATABASE_URL=postgresql://webnion:webnion_local@localhost:5440/webnion_test

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API (0 when none, 1 behind Nginx or a platform proxy)
TRUST_PROXY_HOPS=0

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Used only by npm run db:seed to create the first admin
ADMIN_EMAIL=hello@webnion.com
ADMIN_PASSWORD=

# Where images and videos uploaded from the admin panel are stored. Must survive restarts and deploys.
UPLOAD_DIR=uploads

# Optional: when all three are set, new uploads go to Cloudinary instead of UPLOAD_DIR.
# Find them in the Cloudinary console under Settings > API Keys. Run npm run media:migrate to move existing files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=webnion

# Optional: inquiry notification emails are skipped when SMTP_HOST is empty
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Webnion <hello@webnion.com>
INQUIRY_NOTIFY_TO=hello@webnion.com
