generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  EDITOR
}

enum TestimonialKind {
  VIDEO
  RESULT
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

// Fields typed Json hold translated text: { "en": "...", "bn": "..." }

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Service {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       Json
  description Json
  image       String @db.VarChar(2048)
  content     Json?
  // Same format as content: each heading is a question and the paragraphs after it are the answer
  faqs        Json?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("services")
}

// Fields named content hold translated article blocks: { "en": [...], "bn": [...] }. bn is optional and falls back to en.

model Project {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  category    Json
  image       String @db.VarChar(2048)
  url         String? @db.VarChar(2048)
  client      String?
  budget      Json?
  location    Json?
  sector      Json?
  completedAt DateTime?
  content     Json?
  isFeatured  Boolean   @default(false)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, sortOrder])
  @@map("projects")
}

model Product {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       Json
  summary    Json
  image      String @db.VarChar(2048)
  type       String
  category   String
  pricing    String   @default("PAID")
  price      Int?
  currency   String   @default("USD")
  url        String? @db.VarChar(2048)
  views      Int      @default(0)
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("products")
}

model CaseStudy {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       Json
  category    Json
  image       String @db.VarChar(2048)
  content     Json
  publishedAt DateTime?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, sortOrder])
  @@map("case_studies")
}

model Testimonial {
  id        String          @id @default(uuid())
  kind      TestimonialKind
  name      String
  role      Json
  avatar    String? @db.VarChar(2048)
  image     String @db.VarChar(2048)
  videoUrl  String? @db.VarChar(2048)
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([isActive, sortOrder])
  @@map("testimonials")
}

model DeliveryStory {
  id        String   @id @default(uuid())
  title     Json
  caption   Json
  image     String @db.VarChar(2048)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("delivery_stories")
}

model OutcomeCard {
  id          String   @id @default(uuid())
  eyebrow     Json?
  title       Json
  description Json
  points      Json
  image       String @db.VarChar(2048)
  buttonLabel Json?
  buttonUrl   String? @db.VarChar(2048)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("outcome_cards")
}

// A record of what happens on the website: logins, every change made in the admin panel, uploads and new inquiries.
// Only the names of changed fields are kept, never their values.
model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  resource   String? @db.VarChar(64)
  resourceId String?
  summary    String @db.Text
  details    String? @db.Text
  actorId    String?
  actorName  String?
  actorEmail String?
  ip         String? @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@map("activity_logs")
}

// Site-wide settings edited in the admin panel, one row per group: contact, images and text
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model Technology {
  id          String   @id @default(uuid())
  name        String
  description Json
  logo        String @db.VarChar(2048)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("technologies")
}

// Background images for the homepage hero. The first visible one is shown.
model HeroBackground {
  id        String   @id @default(uuid())
  name      String
  image     String @db.VarChar(2048)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("hero_backgrounds")
}

model PricingPlan {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       Json
  tagline    Json
  badge      Json?
  price      Int
  currency   String   @default("USD")
  features   Json
  // Optional words beside the price (Starting, /month), on the button, and a small note at the bottom of the card
  priceLabel  Json?
  buttonLabel Json?
  note        Json?
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("pricing_plans")
}

model Faq {
  id        String   @id @default(uuid())
  question  Json
  answer    Json
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("faqs")
}

model TeamMember {
  id        String   @id @default(uuid())
  name      Json
  role      Json
  photo     String @db.VarChar(2048)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("team_members")
}

model ClientLogo {
  id        String   @id @default(uuid())
  name      String
  logo      String @db.VarChar(2048)
  url       String? @db.VarChar(2048)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("client_logos")
}

model Inquiry {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String
  company   String?
  service   String?
  budget    String?
  country   String?
  existingWebsite String? @db.VarChar(300)
  message   String @db.Text
  locale    String        @default("en")
  // "form" or "chat"
  source    String        @default("form") @db.VarChar(16)
  status    InquiryStatus @default(NEW)
  notes     String? @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("inquiries")
}

// AI assistant and blog writer. One row, id "main". Provider keys inside are encrypted with AI_SECRETS_KEY.
model AiSetting {
  id        String   @id @default("main") @db.VarChar(16)
  value     Json
  updatedAt DateTime @updatedAt

  @@map("ai_settings")
}

// Requests, tokens and pictures per day and feature, for the AI Usage screen and the daily caps
model AiUsage {
  day          DateTime @db.Date
  feature      String   @db.VarChar(32)
  requests     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  pictures     Int      @default(0)
  errors       Int      @default(0)

  @@id([day, feature])
  @@map("ai_usage")
}

// Chat messages per visitor per day. The visitor is a keyed hash of the IP address, never the address itself.
model AiVisitorUsage {
  day      DateTime @db.Date
  visitor  String   @db.Char(64)
  messages Int      @default(0)

  @@id([day, visitor])
  @@map("ai_visitor_usage")
}

// What is in the search index, so only records that changed are sent again
model AiIndexEntry {
  key       String   @id @db.VarChar(200)
  hash      String   @db.Char(64)
  updatedAt DateTime @updatedAt

  @@map("ai_index_entries")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id             String     @id @default(uuid())
  slug           String     @unique
  title          Json
  excerpt        Json?
  content        Json
  cover          String?    @db.VarChar(2048)
  coverAlt       Json?
  tags           String?    @db.VarChar(400)
  seoTitle       Json?
  seoDescription Json?
  status         BlogStatus @default(DRAFT)
  publishedAt    DateTime?
  authorName     String?    @db.VarChar(120)
  aiGenerated    Boolean    @default(false)
  aiMeta         Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, publishedAt])
  @@map("blog_posts")
}
